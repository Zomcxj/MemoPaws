{
  "productName": "MemoPaws",
  "version": "0.0.4",
  "identifier": "com.memopaws.rust",
  "build": {
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ../frontend run build",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MemoPaws",
        "width": 1460,
        "height": 960,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "transparent": true,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/pins/**"]
      }
    }
  },
  "bundle": {
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
